# =============================================================================
# SPARK on AWS — central demo configuration
# =============================================================================
# 1. Copy:        cp .env.example .env
# 2. Set values (NEVER commit real account IDs, zones, profiles!)
# 3. Deployment:  make -C spark-workflow-demo apply   (reads ../.env)
#
# .env is excluded from tracking via .gitignore.
# =============================================================================

# --- AWS base configuration ---------------------------------------------------
# Named AWS CLI profile with admin/deploy permissions in the demo account
AWS_PROFILE=my-demo-profile
# Target region of the demo deployments
AWS_REGION=eu-central-1
# Region for Bedrock calls (gpt-oss-120b on-demand + the eu. Pixtral vision
# profile are both available in eu-central-1; may differ from AWS_REGION —
# a different region means prompts and document content cross a region
# boundary, see docs/THREAT-MODEL.md D4)
BEDROCK_REGION=eu-central-1
# Vision model for the VLM enhancement stage (Bedrock model/profile ID).
# Must be image-capable AND reachable from BEDROCK_REGION; the eu. prefix
# keeps cross-region routing inside the EU geography.
# BEDROCK_VLM_MODEL_ID=eu.mistral.pixtral-large-2502-v1:0

# --- DNS / TLS ------------------------------------------------------------------
# Route53 hosted zone (public) under which the demo hosts are created
ROUTE53_ZONE_ID=Z0EXAMPLE12345678
# Base domain of the hosted zone (without a leading dot)
BASE_DOMAIN=demo.example.com
# E-mail for the Let's Encrypt registration (cert-manager)
ACME_EMAIL=you@example.com

# --- Network exposure (BOTH demos) ----------------------------------------------
# Comma-separated CIDRs allowed to reach the demos' public load balancers.
# Unset/empty = reachable from the whole internet.
#
# Set this for any deployment whose hosts must not be publicly reachable
# (e.g. a company or personal AWS account): a security scan of the live
# deployment flags every publicly reachable host EVEN IF all routes sit
# behind OIDC, because the login page itself answers unauthenticated
# callers. Enforced at L4 on the NLB, so one value covers every hostname
# and both :80/:443 — and the same CIDRs fence the public EKS API endpoint,
# so include the address you run terraform/kubectl from.
# Alternative for occasional demos: keep it open but run `make destroy`
# after the demo (from-zero bring-up is reproducible via `make bootstrap`).
# DEMO_ALLOWED_CIDRS=203.0.113.4/32,198.51.100.0/24

# --- Project namespacing --------------------------------------------------------
# Prefix for all resource names (lowercase, alphanumeric + hyphen)
PROJECT_PREFIX=spark-demo

# --- spark-workflow-demo --------------------------------------------------------
# Subdomain hosts (created as <host>.$BASE_DOMAIN)
SPARK_WORKFLOW_HOST=workflow
SPARK_WORKFLOW_KEYCLOAK_HOST=auth-workflow
SPARK_WORKFLOW_TEMPORAL_HOST=temporal-workflow
# Demo login user (created in the Keycloak realm)
SPARK_WORKFLOW_DEMO_USER_EMAIL=demo.user@example.com
# Feature flags / sizing (defaults: see terraform variables.tf; overrides only)
# SPARK_WORKFLOW_GPU_ENABLED=false
# SPARK_WORKFLOW_VALKEY_ENABLED=true
# SPARK_WORKFLOW_SEED_JOBS_ENABLED=true   # upstream lookup-data seeds after each deploy
# SPARK_WORKFLOW_NODE_INSTANCE_TYPE=m6i.2xlarge
# 73 pods with upstream requests need 4 nodes (m6i.2xlarge)
SPARK_WORKFLOW_NODE_COUNT=4
# SPARK_WORKFLOW_RDS_INSTANCE_CLASS=db.r6g.xlarge
# RDS deletion protection (default false so `make destroy` stays hands-off;
# set true for an environment that outlives a demo day)
# SPARK_WORKFLOW_RDS_DELETION_PROTECTION=false

# --- spark-api-demo ---------------------------------------------------------------
SPARK_API_HOST=api-suite
# Resource name prefix (must differ from PROJECT_PREFIX of other demos in
# the same account; default: spark-api-demo)
# SPARK_API_PROJECT_PREFIX=spark-api-demo
# Sizing overrides (defaults: see terraform variables.tf)
# SPARK_API_NODE_INSTANCE_TYPE=m6i.2xlarge
# SPARK_API_NODE_COUNT=3
# SPARK_API_STATEFUL_NODE_COUNT=1
# SPARK_API_RDS_INSTANCE_CLASS=db.r6g.large
# SPARK_API_RDS_DELETION_PROTECTION=false
# Auth perimeter (Keycloak + oauth2-proxy); host becomes <host>.<BASE_DOMAIN>
# SPARK_API_AUTH_HOST=auth-api
# false is refused by terraform unless DEMO_ALLOWED_CIDRS is set (no
# perimeter + open NLB would expose every service anonymously)
# SPARK_API_AUTH_ENABLED=true
# Git ref (commit/tag) of the spark-api build; empty = submodule HEAD is used
# SPARK_API_GIT_REF=
