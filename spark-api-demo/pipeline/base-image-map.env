# Mapping of upstream registry placeholders to public base images.
# Format: PLACEHOLDER_PATH=PUBLIC_IMAGE
# Applied by pipeline/prepare-context.sh via sed in the CI workspace —
# the upstream repo/submodule remains unchanged.
#
# Digest pins will be added on the first successful CodeBuild run.
astral-uv-python-3.12-bookworm:1.0.0=ghcr.io/astral-sh/uv:python3.12-bookworm
python-3.12-bookworm:1.0.0=public.ecr.aws/docker/library/python:3.12-bookworm
python-3.13-bookworm:1.0.0=public.ecr.aws/docker/library/python:3.13-bookworm
node:20-bookworm=public.ecr.aws/docker/library/node:20-bookworm
nginx-1.27-alpine:1.0.0=public.ecr.aws/nginx/nginx:1.27-alpine
nginx-unprivileged:1.29-alpine=docker.io/nginxinc/nginx-unprivileged:1.29-alpine
