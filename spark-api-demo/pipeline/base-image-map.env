# Mapping of upstream base-image references to public base images.
# Format: UPSTREAM_REFERENCE=PUBLIC_IMAGE
# Applied by pipeline/prepare-context.sh via sed in the CI workspace —
# the upstream repo/submodule remains unchanged. A row matches both forms
# upstream uses: the placeholder `<CONTAINER_REGISTRY>/<ref>` anywhere in
# the Dockerfile, and a bare `FROM <ref>` / `FROM docker.io/<ref>` line
# (since v0.5.1 the frontend, request-proxy and ki-guv-feedback Dockerfiles
# carry Docker Hub references without the placeholder; left alone they
# would pull through the NAT address against the anonymous Docker Hub
# rate limit).
#
# Digest pins will be added on the first successful CodeBuild run.
astral-uv-python-3.12-bookworm:1.0.0=ghcr.io/astral-sh/uv:python3.12-bookworm
python-3.12-bookworm:1.0.0=public.ecr.aws/docker/library/python:3.12-bookworm
python-3.13-bookworm:1.0.0=public.ecr.aws/docker/library/python:3.13-bookworm
# v0.5.1: dokumentenschwaerzung-orchestrator and -pdf-pii-detector build
# their test-deps stage from a uv release pinned by tag + digest. The
# suffix upstream appended to the placeholder IS the ghcr.io index digest
# of that tag (verified against the registry), so the pin is kept.
uv:0.9.30-python3.12-bookworm-slim-e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58=ghcr.io/astral-sh/uv:0.9.30-python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58
node:20-bookworm=public.ecr.aws/docker/library/node:20-bookworm
python:3.12-bookworm=public.ecr.aws/docker/library/python:3.12-bookworm
python:3.12-slim-bookworm=public.ecr.aws/docker/library/python:3.12-slim-bookworm
nginx-1.27-alpine:1.0.0=public.ecr.aws/nginx/nginx:1.27-alpine
nginxinc/nginx-unprivileged:1.29-alpine=public.ecr.aws/nginx/nginx-unprivileged:1.29-alpine
