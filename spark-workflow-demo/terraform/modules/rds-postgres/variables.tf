variable "name" {
  description = "Identifier prefix of the RDS instance."
  type        = string
}

variable "vpc_id" {
  description = "VPC of the DB instance."
  type        = string
}

variable "private_subnet_ids" {
  description = "Private subnets for the DB subnet group."
  type        = list(string)
}

variable "allowed_security_groups" {
  description = "Security groups allowed to reach PostgreSQL, keyed by a static name (values may be apply-time unknown)."
  type        = map(string)
}

variable "engine_version" {
  description = "PostgreSQL major engine version (pgvector must be available)."
  type        = string
  default     = "16"
}

variable "instance_class" {
  description = "RDS instance class."
  type        = string
  default     = "db.r6g.xlarge"
}

variable "allocated_storage" {
  description = "Allocated storage in GiB (gp3)."
  type        = number
  default     = 100
}

variable "multi_az" {
  description = "Multi-AZ deployment (demo default: false, documented deviation)."
  type        = bool
  default     = false
}

variable "force_ssl" {
  description = "Enforce SSL on all connections (rds.force_ssl). Demo default false: upstream DSNs do not consistently set sslmode. Documented deviation."
  type        = bool
  default     = false
}

variable "master_username" {
  description = "Master user name."
  type        = string
  default     = "postgres"
}

variable "master_password" {
  description = "Master user password (generated by the secrets module)."
  type        = string
  sensitive   = true
}

variable "deletion_protection" {
  description = "Protect the instance against deletion. Demo default false so `make destroy` stays hands-off; set true for longer-lived environments."
  type        = bool
  default     = false
}

variable "kms_key_arn" {
  description = "Customer-managed KMS key for Performance Insights and the exported CloudWatch log groups (kms module)."
  type        = string
}

variable "cloudwatch_logs_retention_days" {
  description = "Retention of the exported log groups in days."
  type        = number
  default     = 365
}

variable "monitoring_interval" {
  description = "Enhanced Monitoring interval in seconds (0 disables it and skips the monitoring role)."
  type        = number
  default     = 60
}

variable "tags" {
  description = "Tags applied to all resources."
  type        = map(string)
  default     = {}
}
