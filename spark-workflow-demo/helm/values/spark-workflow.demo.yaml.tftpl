        # Embedding timeout (db-services-shared LLMConfig default 5 s): the
        # CPU bge-m3 (TEI) answers in 60 ms idle but queues under the
        # parallel research of the material completeness check (measured
        # 2026-10-20: 382 of 622 requests over 2 s, max 84 s; 31 of 109
        # query_top_k calls -> 500 APITimeoutError).
        - name: CHUNKING_TIMEOUT
          value: "120"
        - name: CHUNKING_APIKEY
